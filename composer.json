{
    "name": "sendivent/sdk",
    "version": "0.5.1",
    "description": "Official PHP SDK for Sendivent - Multi-channel notification platform",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "sendivent",
        "notifications",
        "email",
        "sms",
        "slack"
    ],
    "authors": [
        {
            "name": "Sendivent",
            "email": "support@sendivent.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Sendivent\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Sendivent\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
